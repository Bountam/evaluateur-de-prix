# GCSurplus — Identifiants d'accès autorisés Insertech
# Configurez vos identifiants de connexion GCSurplus ici.
GCSURPLUS_USERNAME=""
GCSURPLUS_PASSWORD=""

# Chemin vers le fichier Excel des prix internes Insertech (boutique/atelier)
# Par défaut: data/insertech-prices.xlsx
INSERTECH_DATA_PATH="data/insertech-prices.xlsx"

# Chemin vers le dossier d'archives des anciennes analyses
# Par défaut: data/archives/
INSERTECH_ARCHIVES_PATH="data/archives/"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
